;
; Zenith fork: the sandbox the island catalog renders in (render.sh). The
; renderer already keeps to sample data; this makes sure it cannot reach the
; network, the Keychain, the preferences daemon, notifications or the camera,
; and writes nowhere but its output folder (OUTPUT) and the system temp folders.
(version 1)
(allow default)
(deny network-outbound (remote ip))
(deny network-inbound (local ip))
(deny network-bind (local ip))
(deny mach-lookup
    (global-name "com.apple.cfprefsd.daemon")
    (global-name "com.apple.cfprefsd.agent")
    (global-name "com.apple.SecurityServer")
    (global-name "com.apple.securityd.xpc")
    (global-name "com.apple.secd")
    (global-name "com.apple.usernotifications.listener")
    (global-name "com.apple.usernotifications.usernotificationservice")
    (global-name "com.apple.locationd.registration")
    (global-name "com.apple.locationd.desktop.registration"))
(deny device-camera)
(deny device-microphone)
(deny file-write* (subpath "/Users"))
(deny file-read* (subpath (param "APP_SUPPORT")))
(deny file-read* (subpath (param "KEYCHAINS")))
(deny file-read* (regex (param "PREFERENCES")))
(allow file-write* (subpath (param "OUTPUT")))
