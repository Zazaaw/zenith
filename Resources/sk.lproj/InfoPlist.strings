/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "Zenith používa Automatizáciu na presúvanie súborov, presun položiek do Koša, otváranie vyžiadaných príkazov, odosielanie odpovedí napísaných v Dynamic Island do Správ a na ovládanie prehrávania vo vašich mediálnych aplikáciách.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "Zenith používa zvuk každej aplikácie na nastavenie jej hlasitosti v mixéri, na rozpohybovanie hudobných stĺpcov Dynamic Island a na pridanie zvuku Macu do nahrávok obrazovky, ktoré spustíte. Nič neopustí váš Mac.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "Zenith používa Bluetooth len na načítanie stavu batérie pripojeného príslušenstva. Nič neopustí váš Mac.";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "Zenith nahráva váš mikrofón len vtedy, keď ho zapnete pre nahrávanie obrazovky. Zvuk ostáva na vašom Macu, pokiaľ sa nerozhodnete vytvoriť dočasný odkaz.";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "Zenith zobrazuje vašu kameru len v okne náhľadu, ktoré otvoríte, aby ste pred hovorom videli, ako vyzeráte. Nič sa nenahráva a nič neopustí váš Mac.";

/* macOS Downloads folder permission prompt. */
"NSDownloadsFolderUsageDescription" = "Zenith kontroluje lokálne metadáta v priečinku Stiahnuté, aby preveril, usporiadal alebo presunul do Koša len potvrdené súbory z WhatsAppu, ktoré vyberiete. Čistenie tiež hľadá zabudnuté snímky obrazovky, ak ich sem ukladáte.";

