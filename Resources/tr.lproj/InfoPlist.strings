/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "Zenith; dosyaları taşımak, öğeleri Çöp Sepeti’ne göndermek, istenen komutları açmak, Dynamic Island’da yazdığın yanıtları Mesajlar’a göndermek ve medya uygulamalarınızda oynatmayı denetlemek için Otomasyon kullanır.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "Zenith, mikserde ses düzeyini ayarlamak, Dynamic Island'ın müzik çubuklarını hareket ettirmek ve başlattığın ekran kayıtlarına Mac'in sesini eklemek için her uygulamanın sesini kullanır. Hiçbir şey Mac'inden çıkmaz.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "Zenith, Bluetooth'u yalnızca bağlı çevre birimlerinin pil düzeyini okumak için kullanır. Hiçbir veri Mac'inden çıkmaz.";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "Zenith, mikrofonunuzu yalnızca ekran kaydı için açtığınızda kaydeder. Geçici bir bağlantı oluşturmadığınız sürece ses Mac'inizde kalır.";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "Zenith, kameranızı yalnızca açtığınız önizleme penceresinde gösterir; böylece aramadan önce nasıl göründüğünüzü kontrol edebilirsiniz. Hiçbir şey kaydedilmez veya Mac'inizden çıkmaz.";

