/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "O Zenith usa a Automação para mover arquivos, enviar itens ao Lixo, abrir comandos solicitados, enviar ao Mensagens as respostas que você escreve na Dynamic Island e controlar a reprodução nos seus apps de mídia.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "O Zenith usa o áudio de cada app para ajustar o volume no mixer, para mover as barras de música da Dynamic Island e para incluir o som do Mac nas gravações de tela que você iniciar. Nada sai do seu Mac.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "O Zenith usa o Bluetooth apenas para ler a bateria dos periféricos conectados. Nada sai do seu Mac.";

/* macOS Microphone permission prompt. */
