"NSDocumentsFolderUsageDescription" = "Zenith 将确认的 WhatsApp 下载整理到你明确选择的目标文件夹中。如果你把截图保存在这里，清理功能还会查找被遗忘的截图。";
"NSNetworkVolumesUsageDescription" = "Zenith 将确认的 WhatsApp 下载整理到你明确选择的目标文件夹中。如果你把截图保存在这里，清理功能还会查找被遗忘的截图。";
"NSRemovableVolumesUsageDescription" = "Zenith 将确认的 WhatsApp 下载整理到你明确选择的目标文件夹中。如果你把截图保存在这里，清理功能还会查找被遗忘的截图。";
"NSCalendarsFullAccessUsageDescription" = "在屏幕顶部显示即将到来的日程。日历事件仅保留在这台 Mac 上。";

/* macOS Location Services permission prompt (Zenith fork: lock screen weather). */
"NSLocationUsageDescription" = "Zenith 仅使用你的大致位置来显示锁定屏幕上的天气，以及礼拜时间和黄金时刻。位置会舍入到约一公里。礼拜时间在这台 Mac 上计算；只有天气会把位置发送给 Open-Meteo 以获取天气预报。";
"NSLocationWhenInUseUsageDescription" = "Zenith 仅使用你的大致位置来显示锁定屏幕上的天气，以及礼拜时间和黄金时刻。位置会舍入到约一公里。礼拜时间在这台 Mac 上计算；只有天气会把位置发送给 Open-Meteo 以获取天气预报。";

